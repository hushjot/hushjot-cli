{
  "name": "@hushjot/cli",
  "version": "0.1.1",
  "description": "Read and write your end-to-end encrypted HushJot notes from the terminal, and from an agent over MCP. The key never leaves your machine.",
  "license": "AGPL-3.0-only",
  "author": "Nebulosa d'Ideias Unipessoal Lda.",
  "homepage": "https://hushjot.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/hushjot/hushjot-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hushjot/hushjot-cli/issues"
  },
  "type": "module",
  "bin": {
    "hushjot": "dist/bin/hushjot.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin/hushjot.js',0o755)\"",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node tests/integration/run.mjs",
    "verify": "npm run check && npm test && npm run test:integration",
    "prepare": "npm run build",
    "local": "npm run build && npm link",
    "unlink": "npm unlink -g @hushjot/cli",
    "prepublishOnly": "node tools/guard-publish.mjs"
  },
  "dependencies": {
    "@hushjot/core": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true
}
